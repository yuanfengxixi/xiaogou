# ── 运行时状态 ────────────────────────────────────────────────

var collection_log: Dictionary = {}  # 宝物获取记录 {item_name: count}

# 宝物获取时调用（由 game.gd 在发放 item 时调用）
# 返回 true 表示首次获得（可触发解锁弹窗）
func on_item_collected(item_name: String) -> bool:
	if item_name == "":
		return false
	var is_first = item_name not in collection_log
	if item_name not in collection_log:
		collection_log[item_name] = 0
	collection_log[item_name] += 1
	return is_first

# ── 展示文本 ─────────────────────────────────────────────────

func get_collection_text(_player) -> String:
	var item_text = "【宝物图鉴】\n"
	if collection_log.is_empty():
		item_text += "  （尚未收集任何宝物）\n"
	else:
		for item_name in collection_log:
			var count = collection_log[item_name]
			var meta  = ITEM_META.get(item_name, {})
			var desc  = meta.get("desc", "无记录")
			var src   = meta.get("source", "不详")
			item_text += "  ▸ 【" + item_name + "】× " + str(count) + "\n"
			item_text += "    " + desc + "\n"
			item_text += "    来源：" + src + "\n"
	return item_text
