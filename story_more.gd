# 公式：P = prestige/(prestige+100) × luck_multiplier
#
# 数据格式：
# {
#   "type": "hidden",
#   "title": String,          # 事件标题
#   "rounds": [               # 3-5个轮次
#     {
#       "text": String,       # 当前轮情境描述
#       "choices": [
#         {
#           "text": String,   # 选项文字
#           "result": String, # 即时反馈描述
#           "score": int,     # 得分 0-3
#         }
#       ]
#     }
#   ],
#   "endings": {
#     "perfect": {            # 完美结局
#       "min_score": int,     # 触发所需最低分
#       "text": String,       # 结局描述
#       "gold": int,
#       "prestige": int,
#       "item": String,       # ""表示无道具
#       "lifespan": int,      # 负值为消耗
#     },
#     "good": { ... },        # 良好结局
#     "normal": { ... },      # 普通结局
#     "special": {            # 意外结局（可选）
#       "trigger_choices": Array,  # 触发所需的选项索引序列
#       "trigger": String,         # 触发条件描述，供参考
#       "text": String,
#       "gold": int,
#       "prestige": int,
#       "item": String,
#       "lifespan": int,
#     }
#   }
# }
#
# 结局判定优先级：special(选项序列匹配) > perfect(≥min_score) > good(≥min_score) > normal
# cultivation 固定为 0，修为只能通过闭关和聚灵丹获得

